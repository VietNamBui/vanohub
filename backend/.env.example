# Copy file này thành .env rồi điền giá trị.
# Tạo SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=vanohub
POSTGRES_USER=vanohub
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Chế độ SSL PostgreSQL (disable/allow/prefer/require/verify-ca/verify-full)
POSTGRES_SSLMODE=prefer

# Email & bảo mật HTTPS production (mặc định tự điều chỉnh theo DJANGO_DEBUG)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# Chỉ bật True khi reverse proxy tin cậy thiết lập X-Forwarded-Proto=https
DJANGO_SECURE_PROXY_SSL_HEADER=False
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Ngưỡng rate-limit DRF theo phút
DJANGO_THROTTLE_ANON=120/minute
DJANGO_THROTTLE_USER=2000/minute

# CVAT — dùng CVAT_ACCESS_TOKEN (Personal Access Token) HOẶC username/password
CVAT_URL=http://localhost:8080
CVAT_PUBLIC_URL=http://localhost:8080
# Trên Windows + Docker Desktop: "localhost" có thể đi vòng qua WSL (::1) và bị treo.
# Khi đó dùng CVAT_URL=http://127.0.0.1:8080 và CVAT_HOST_HEADER=localhost:8080.
CVAT_HOST_HEADER=
CVAT_ACCESS_TOKEN=
CVAT_USERNAME=
CVAT_PASSWORD=
# Bật True trên production để bắt buộc CVAT_URL dùng https://
CVAT_REQUIRE_HTTPS=False

# Các origin frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
