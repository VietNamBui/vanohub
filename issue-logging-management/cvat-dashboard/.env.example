DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Database (leave DB_ENGINE unset for local SQLite; set postgresql for production)
# DB_ENGINE=postgresql
# DB_NAME=cvat_dashboard
# DB_USER=cvat_dashboard
# DB_PASSWORD=cvat_dashboard
# DB_HOST=localhost
# DB_PORT=5432

# Internal CVAT server-to-server connection (never exposed to browser)
CVAT_BASE_URL=http://localhost:8080
CVAT_SERVICE_TOKEN=
CVAT_WEBHOOK_SECRET=

# Optional ClickHouse connection (read-only on CVAT events DB)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=cvat
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# SLA thresholds (hours) per Data Cycle stage
SLA_ANNOTATOR_HOURS=24
SLA_L1_QC_HOURS=12
SLA_L2_QC_HOURS=12
SLA_DEPT_HEAD_HOURS=12
